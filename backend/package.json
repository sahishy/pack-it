{
  "name": "pack-it-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "check": "WRANGLER_LOG_PATH=/tmp/pack-it-wrangler.log wrangler deploy --dry-run --outdir dist --env=\"\"",
    "check:production": "WRANGLER_LOG_PATH=/tmp/pack-it-wrangler.log wrangler deploy --dry-run --outdir dist-production --env production"
  },
  "dependencies": {
    "jose": "^6.1.0",
    "openai": "^4.104.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "wrangler": "^4.68.0"
  }
}
